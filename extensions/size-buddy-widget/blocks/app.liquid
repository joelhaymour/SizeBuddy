<div class="size-buddy-widget" id="size-buddy-widget" data-product-id="{{ product.id }}" data-shop-domain="{{ shop.permanent_domain }}" data-button-color="{{ block.settings.button_color }}" data-button-text-color="{{ block.settings.button_text_color }}" data-slider-track-color="{{ block.settings.slider_track_color }}" data-slider-fill-color="{{ block.settings.slider_fill_color }}" data-atc-button-color="{{ block.settings.atc_button_color }}"{% if block.settings.backend_url != blank %} data-backend-url="{{ block.settings.backend_url }}"{% endif %}>
  <button class="size-buddy-button">Size Buddy</button>
  <div class="size-buddy-content"></div>
</div>

<script>
  (function() {
    // Create a function to initialize the widget
    function initializeSizeBuddy() {
      // Remove any existing Size Buddy scripts first to avoid conflicts
      const existingScripts = document.querySelectorAll('script[src*="size-buddy"]');
      existingScripts.forEach(script => script.remove());
      
      // Load the bundled theme app extension asset directly from Shopify CDN
      {% assign sb_asset = "size-buddy-v4.js" | asset_url %}
      const script = document.createElement('script');
      script.src = '{{ sb_asset }}' + ('{{ sb_asset }}'.indexOf('?') >= 0 ? '&' : '?') + 'v=onepieceband1';
      script.async = true;
      
      // Add load event listener to ensure script is fully loaded
      script.onload = function() {
        console.log('Size Buddy V4: Script loaded successfully');
        // Dispatch a custom event to trigger widget initialization
        document.dispatchEvent(new CustomEvent('sizeBuddyScriptLoaded'));
      };
      
      script.onerror = function(error) {
        console.error('Size Buddy V4: Failed to load script:', error);
      };
      
      document.body.appendChild(script);
      
      console.log('Size Buddy V4: Loading modal widget for product {{ product.id }} from shop {{ shop.permanent_domain }}');
    }
    
    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeSizeBuddy);
    } else {
      initializeSizeBuddy();
    }
  })();
</script>

{% schema %}
{
  "name": "Size Buddy",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "button_color",
      "label": "Find My Size button color",
      "default": "#4A90E2"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Find My Size text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "slider_track_color",
      "label": "Slider track color",
      "default": "#d8d8d8"
    },
    {
      "type": "color",
      "id": "slider_fill_color",
      "label": "Slider fill color",
      "default": "#4A90E2"
    },
    {
      "type": "color",
      "id": "atc_button_color",
      "label": "Add to cart button color",
      "default": "#4A90E2"
    },
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend URL (for local testing)",
      "info": "Default uses production. When testing with ngrok, set to your ngrok URL (e.g. https://xxxx.ngrok.app) so the fallback uses your local data.",
      "default": "https://sizebuddy.onrender.com"
    }
  ]
}
{% endschema %} 
